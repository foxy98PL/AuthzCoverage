{
  "permissions": {
    "allow": [
      "Bash(git push origin main)"
    ],
    "deny": [
      "Artifact",
      "ScheduleWakeup",
      "ReportFindings",
      "ListAgents",
      "Agent(general-purpose)",
      "Agent(claude)",
      "Agent(Explore)",
      "Agent(Plan)",
      "Agent(claude-code-guide)",
      "Agent(statusline-setup)",
      "Agent(web-fetch)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/trim-output.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/context-warn.py\""
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "anthropic-skills:built-in-browser": "user-invocable-only",
    "anthropic-skills:chrome-browser": "user-invocable-only",
    "anthropic-skills:computer-use": "user-invocable-only",
