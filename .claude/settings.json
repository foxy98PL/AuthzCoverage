{
  "permissions": {
    "allow": [
      "Bash(git push origin main)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/trim-output.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/context-warn.py\""
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "anthropic-skills:built-in-browser": "user-invocable-only",
    "anthropic-skills:chrome-browser": "user-invocable-only",
    "anthropic-skills:computer-use": "user-invocable-only",
    "anthropic-skills:docs": "user-invocable-only",
    "anthropic-skills:docx": "user-invocable-only",
    "anthropic-skills:google-workspace": "user-invocable-only",
    "anthropic-skills:import-memory": "user-invocable-only",
    "anthropic-skills:morning": "user-invocable-only",
    "anthropic-skills:pdf": "user-invocable-only",
    "anthropic-skills:pptx": "user-invocable-only",
    "anthropic-skills:xlsx": "user-invocable-only",
    "anthropic-skills:skill-creator": "user-invocable-only",
    "claude_ai_Atlassian_MCP:assess-release": "user-invocable-only",
    "claude_ai_Atlassian_MCP:atlassian-design": "user-invocable-only",
    "claude_ai_Atlassian_MCP:before-you-start": "user-invocable-only",
    "claude_ai_Atlassian_MCP:catch-up": "user-invocable-only",
    "claude_ai_Atlassian_MCP:decision-trace": "user-invocable-only",
    "claude_ai_Atlassian_MCP:dependency-map": "user-invocable-only",
